<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="login-body ebolt-login-body">
  <header class="login-brand-header" aria-label="Application brand">
    <div class="ebolt-brand-mark" aria-hidden="true">
      <span></span>
    </div>
    <strong>Ebolt</strong>
  </header>

  <main class="login-shell ebolt-login-shell">
    <section class="login-panel ebolt-login-card" aria-labelledby="login-title">
      <div class="login-card-icon" aria-hidden="true">
        <span>↪</span>
      </div>

      <h1 id="login-title">Sign in with email</h1>
      <p class="login-subtitle">Make a new doc to bring your words, data,<br />and teams together. For free</p>

      <% if (error) { %>
        <div class="alert"><%= error %></div>
      <% } %>

      <form class="login-form ebolt-login-form" action="/login" method="POST">
        <div class="input-wrap">
          <span class="field-icon" aria-hidden="true">✉</span>
          <input id="username" name="username" type="text" placeholder="Email" autocomplete="username" required />
        </div>

        <div class="input-wrap password-wrap">
          <span class="field-icon" aria-hidden="true">🔒</span>
          <input id="password" name="password" type="password" placeholder="Password" autocomplete="current-password" required />
          <span class="field-icon right" aria-hidden="true">◒</span>
        </div>

        <a class="forgot-link" href="#">Forgot password?</a>

        <button class="primary-button ebolt-primary-button" type="submit">Get Started</button>
      </form>

      <div class="divider-text ebolt-divider">
        <span>Or sign in with</span>
      </div>

      <a class="entra-icon-button" href="/auth/entra" aria-label="Continue with Microsoft">
        <span class="microsoft-grid" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span>Microsoft</span>
      </a>
    </section>
  </main>
</body>
</html>